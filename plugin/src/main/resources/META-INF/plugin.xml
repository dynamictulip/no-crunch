<idea-plugin>
    <id>com.nocrunch.rider</id>
    <name>No Crunch</name>
    <vendor>No Crunch</vendor>
    <description><![CDATA[
      Continuous testing for .NET in Rider on macOS. Reruns the tests affected by your changes in an isolated
      mirror of the repo, using Microsoft.Testing.Platform.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.nocrunch.rider.NoCrunchStartup"/>
        <toolWindow id="No Crunch" anchor="bottom" factoryClass="com.nocrunch.rider.ui.NoCrunchToolWindowFactory"
                    icon="/icons/cupcake.svg"/>
        <statusBarWidgetFactory id="NoCrunchStatus" implementation="com.nocrunch.rider.ui.NoCrunchStatusBarWidgetFactory"/>
        <projectConfigurable parentId="tools" instance="com.nocrunch.rider.settings.NoCrunchConfigurable"
                             id="com.nocrunch.rider.settings" displayName="No Crunch"/>
    </extensions>

    <projectListeners>
        <listener class="com.nocrunch.rider.files.FileChangeForwarder"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>
